---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
}

const { 
  title = 'Rob — Photography', 
  description = 'Street, landscape, and life.',
  activePage = '' 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="caramellatte" id="theme-root">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="min-h-screen flex flex-col">
  <Nav activePage={activePage} />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
  <script>
    (function() {
      const root = document.getElementById('theme-root');
      const toggle = document.getElementById('theme-toggle');
      const sun = document.getElementById('sun-icon');
      const moon = document.getElementById('moon-icon');

      function setTheme(theme) {
        root.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
        if (sun && moon) {
          sun.classList.toggle('hidden', theme === 'caramellatte');
          moon.classList.toggle('hidden', theme !== 'caramellatte');
        }
      }

      const saved = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (saved) {
        setTheme(saved);
      } else if (prefersDark) {
        setTheme('caramellatte-dark');
      }

      if (toggle) {
        toggle.addEventListener('click', () => {
          const current = root.getAttribute('data-theme');
          const next = current === 'caramellatte' ? 'caramellatte-dark' : 'caramellatte';

          const tmp = document.createElement('div');
          tmp.style.cssText = 'position:fixed;visibility:hidden;background:var(--color-base-100);';
          document.body.appendChild(tmp);
          const bg = getComputedStyle(tmp).backgroundColor;
          document.body.removeChild(tmp);

          const wipe = document.createElement('div');
          wipe.style.cssText = `position:fixed;inset:0;z-index:9999;pointer-events:none;background:${bg};`;
          document.body.appendChild(wipe);

          root.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
          if (sun && moon) {
            sun.classList.toggle('hidden', next === 'caramellatte');
            moon.classList.toggle('hidden', next !== 'caramellatte');
          }

          wipe.offsetHeight;
          wipe.classList.add('theme-wiping');

          wipe.addEventListener('animationend', () => wipe.remove(), { once: true });
        });
      }
    })();

    const imgObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.remove('photo-loading');
          entry.target.classList.add('photo-loaded');
          imgObserver.unobserve(entry.target);
        }
      });
    }, { rootMargin: '100px' });

    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    let revealStaggerIndex = 0;

    function observeFadeElements() {
      document.querySelectorAll('[data-scroll-fade]').forEach(el => {
        if (!el.classList.contains('photo-loaded')) {
          imgObserver.observe(el);
        }
      });
    }

    function observeRevealElements(parent) {
      const items = (parent || document).querySelectorAll('.photo-reveal');
      items.forEach((el, i) => {
        if (!el.classList.contains('revealed') && !el.dataset.revealIndex) {
          el.dataset.revealIndex = revealStaggerIndex++;
          const delay = Math.min(i, 10) * 0.08;
          el.style.transitionDelay = `${delay}s`;
          revealObserver.observe(el);
        }
      });
    }

    const domObserver = new MutationObserver(() => {
      observeFadeElements();
      observeRevealElements();
    });
    domObserver.observe(document.body, { childList: true, subtree: true });

    observeFadeElements();
    observeRevealElements();
  </script>
</body>
