---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoCard from '../components/PhotoCard.astro';
import { photos } from '../data/photos';

const curatedIds = ['s1','s2','s3','l1','l2','l4','li1','li2','li3','o1','o3'];
const curated = photos.filter(p => curatedIds.includes(p.id));
---

<BaseLayout activePage="home">

  <section class="pt-28 pb-8 px-6">
    <div class="max-w-7xl mx-auto flex items-end justify-between">
      <div>
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-[var(--color-base-content)] tracking-tight">
          Rob
        </h1>
        <p class="text-xs text-[var(--color-base-content)]/60 tracking-[0.25em] uppercase mt-1 font-display">Photography</p>
      </div>
    </div>
  </section>

  <section class="px-6 pb-16">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-1 sm:gap-2">
        {curated.map((photo) => {
          const aspectRatio = photo.width / photo.height;
          const isWide = aspectRatio > 1.3;
          const isTall = aspectRatio < 0.75;
          return (
            <div class={`photo-reveal ${isWide ? 'sm:col-span-2' : ''} ${isTall ? 'sm:row-span-2' : ''}`}>
              <PhotoCard photo={photo} class="w-full h-full" />
            </div>
          );
        })}
      </div>

    </div>
  </section>

  <section class="border-t border-[var(--color-base-300)]">
    <div class="max-w-7xl mx-auto px-6 py-16 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <p class="text-xs text-[var(--color-base-content)]/60 leading-relaxed max-w-xl font-display tracking-wide">
        Simply enjoy the idea to capture moments and creating memories.
      </p>
        </div>
  </section>

</BaseLayout>
