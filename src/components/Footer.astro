---
const year = new Date().getFullYear();
---

<footer class="mt-auto bg-[var(--color-base-200)] border-t border-[var(--color-base-300)]">
  <div class="max-w-7xl mx-auto px-6 py-12 md:py-16">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div>
        <span class="font-display text-sm font-semibold tracking-wider text-[var(--color-base-content)]">Rob</span>
        <p class="font-display text-[0.6rem] tracking-[0.3em] text-[var(--color-base-content)]/60 uppercase mt-1">Photography</p>
      </div>

      <div class="flex gap-10">
        <div>
          <p class="font-display text-[0.55rem] tracking-[0.2em] text-[var(--color-base-content)]/60 uppercase mb-3">Navigate</p>
          <div class="flex flex-col gap-1.5">
            {[
              { href: '/', label: 'Portfolio' },
              { href: '/gallery', label: 'Gallery' },
              { href: '/about', label: 'Info' },
            ].map(l => (
              <a href={l.href} class="text-xs text-[var(--color-base-content)]/60 hover:text-[var(--color-base-content)] transition-colors font-display tracking-wider">
                {l.label}
              </a>
            ))}
          </div>
        </div>
        <div>
          <p class="font-display text-[0.55rem] tracking-[0.2em] text-[var(--color-base-content)]/60 uppercase mb-3">Social</p>
          <div class="flex gap-3">
            <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" class="text-xs text-[var(--color-base-content)]/60 hover:text-[var(--color-primary)] transition-colors font-display tracking-wider" aria-label="Instagram">
              IG
            </a>
            <a href="https://twitter.com/" target="_blank" rel="noopener noreferrer" class="text-xs text-[var(--color-base-content)]/60 hover:text-[var(--color-primary)] transition-colors font-display tracking-wider" aria-label="Twitter">
              TW
            </a>
            <a href="https://vsco.co/" target="_blank" rel="noopener noreferrer" class="text-xs text-[var(--color-base-content)]/60 hover:text-[var(--color-primary)] transition-colors font-display tracking-wider" aria-label="VSCO">
              VS
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-[var(--color-base-300)] flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-[0.65rem] text-[var(--color-base-content)]/60 tracking-wider">
        &copy; {year} Rob Photography
      </p>
      <p class="text-[0.55rem] text-[var(--color-base-300)] tracking-[0.2em] uppercase">
      Anywhere possible
      </p>
    </div>
  </div>
</footer>
